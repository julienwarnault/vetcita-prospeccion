{
  "name": "vetcita-prospeccion",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "start": "vite preview --host 127.0.0.1",
    "lint": "eslint .",
    "test": "node --import tsx --test tests/*.test.ts tests/*.test.tsx",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply DB --local --config wrangler.jsonc --persist-to .wrangler/state",
    "predev": "npm run db:migrate"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.7.0",
    "hono": "^4.0.0",
    "drizzle-orm": "0.45.2",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "^3.25.76",
    "class-variance-authority": "0.7.1",
    "radix-ui": "^1.6.7",
    "lucide-react": "^1.31.0",
    "tailwind-merge": "3.6.0",
    "maplibre-gl": "^5.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@eslint/js": "^9.39.4",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "^7.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.0.0",
    "vite": "8.0.13",
    "wrangler": "4.92.0",
    "tailwindcss": "4.2.1",
    "@tailwindcss/postcss": "4.2.1"
  },
  "type": "module"
}
